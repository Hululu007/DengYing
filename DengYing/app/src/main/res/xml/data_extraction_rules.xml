<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的数据提取规则（取代 fullBackupContent 在云备份/换机的部分）。

  与 backup_rules.xml 同一口径：用户资产带走，派生数据不带。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
